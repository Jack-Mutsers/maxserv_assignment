<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        {% if product %}
            {{ product.title }}
        {% else %}
            Product not found
        {% endif %}
        | MaxServ
    </title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/css/product.css">

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
</head>
<body>
    <main class="container py-4 py-md-5">
        <a class="back-link" href="/ecommerce">&larr; Back to products</a>

        {% if not product %}
            <section class="not-found text-center">
                <h1>Product not found</h1>
                <p>The requested product is not available.</p>
            </section>
        {% else %}
            {% set images = product.images|default([]) %}
            {% if images is empty and product.thumbnail %}{% set images = [product.thumbnail] %}{% endif %}

            <div class="row product-overview">
                <section class="col-lg-6 mb-4 mb-lg-0" aria-label="Product images">
                    {% if images is not empty %}
                        <div id="product-images" class="carousel slide product-carousel" data-ride="carousel">
                            {% if images|length > 1 %}
                                <ol class="carousel-indicators">
                                    {% for image in images %}
                                        <li data-target="#product-images" data-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}"></li>
                                    {% endfor %}
                                </ol>
                            {% endif %}

                            <div class="carousel-inner">
                                {% for image in images %}
                                    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                                        <img src="{{ image }}" class="d-block w-100" alt="{{ product.title }} — image {{ loop.index }}">
                                    </div>
                                {% endfor %}
                            </div>

                            {% if images|length > 1 %}
                                <a class="carousel-control-prev" href="#product-images" role="button" data-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Previous image</span>
                                </a>

                                <a class="carousel-control-next" href="#product-images" role="button" data-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="sr-only">Next image</span>
                                </a>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="image-placeholder">No product image available</div>
                    {% endif %}
                </section>

                <section class="col-lg-6">
                    <p class="product-category">{{ product.category }}</p>
                    <h1>{{ product.title }}</h1>

                    {% if product.brand %}<p class="product-brand">by {{ product.brand }}</p>{% endif %}

                    <div class="price-row">
                        <span class="product-price">&euro;{{ discountedPrice|number_format(2, ',', '.') }}</span>
                        {% if product.discountPercentage > 0 %}
                            <span class="discount">{{ product.discountPercentage|number_format(0) }}% off</span>
                        {% endif %}
                    </div>

                    {% if product.discountPercentage > 0 %}
                        <p class="original-price">Was &euro;{{ product.price|number_format(2, ',', '.') }}</p>
                    {% endif %}

                    <p class="product-description">{{ product.description }}</p>

                    <dl class="summary-list">
                        <div>
                            <dt>Rating</dt>
                            <dd>{{ product.rating|number_format(1) }} / 5</dd>
                        </div>

                        <div>
                            <dt>Stock</dt>
                            <dd>{{ product.stock }} available</dd>
                        </div>

                        <div>
                            <dt>Availability</dt>
                            <dd>{{ product.availabilityStatus }}</dd>
                        </div>

                        <div>
                            <dt>SKU</dt>
                            <dd>{{ product.sku }}</dd>
                        </div>
                    </dl>

                    {% if product.tags %}
                        <div class="tags" aria-label="Product tags">
                            {% for tag in product.tags %}
                                <span class="tag">{{ tag }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            </div>

            <section class="details-section">
                <h2>Product details</h2>
                <div class="row">
                    <div class="col-md-6">
                        <dl class="detail-list">
                            <div>
                                <dt>Product ID</dt>
                                <dd>{{ product.id }}</dd>
                            </div>
                            
                            <div>
                                <dt>Weight</dt>
                                <dd>{{ product.weight }} kg</dd>
                            </div>
                            
                            <div>
                                <dt>Minimum order quantity</dt>
                                <dd>{{ product.minimumOrderQuantity }}</dd>
                            </div>
                            
                            <div>
                                <dt>Warranty</dt>
                                <dd>{{ product.warrantyInformation }}</dd>
                            </div>
                            
                            <div>
                                <dt>Shipping</dt>
                                <dd>{{ product.shippingInformation }}</dd>
                            </div>
                            
                            <div>
                                <dt>Return policy</dt>
                                <dd>{{ product.returnPolicy }}</dd>
                            </div>
                        </dl>
                    </div>
                    
                    <div class="col-md-6">
                        <dl class="detail-list">
                            <div>
                                <dt>Width</dt>
                                <dd>{{ product.dimensions.width }} cm</dd>
                            </div>
                            
                            <div>
                                <dt>Height</dt>
                                <dd>{{ product.dimensions.height }} cm</dd>
                            </div>
                            
                            <div>
                                <dt>Depth</dt>
                                <dd>{{ product.dimensions.depth }} cm</dd>
                            </div>
                            
                            <div>
                                <dt>Barcode</dt>
                                <dd>{{ product.meta.barcode }}</dd>
                            </div>
                            
                            <div>
                                <dt>Created</dt>
                                <dd>{{ product.meta.createdAt }}</dd>
                            </div>
                            
                            <div>
                                <dt>Updated</dt>
                                <dd>{{ product.meta.updatedAt }}</dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </section>
            
            <section class="details-section">
                <h2>Reviews <span>({{ product.reviews|length }})</span></h2>
                {% if product.reviews %}
                    <div class="review-list">
                        {% for review in product.reviews %}
                            <article class="review">
                                <div class="review-heading">
                                    <strong>{{ review.reviewerName }}</strong>
                                    <span>{{ review.rating|number_format(1) }} / 5</span>
                                </div>
                                
                                <p>{{ review.comment }}</p>
                                <small>{{ review.date }}</small>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted">There are no reviews for this product yet.</p>
                {% endif %}
            </section>
        {% endif %}
    </main>

</body>
</html>
