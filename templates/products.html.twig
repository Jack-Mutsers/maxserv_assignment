{% for product in products %}
    <div class="product">
        <a href="/product/{{ product.sku|url_encode }}">
            <h5>{{ product.title }}</h5>

            {% if product.brand %}
                <p class="brand">{{ product.brand }}</p>
            {% endif %}

            <div class="imageContainer">
                {% if product.thumbnail %}
                    <img src="{{ product.thumbnail }}" alt="{{ product.title }}">
                {% endif %}
            </div>

            <p class="price">
                {% if product.discountPercentage > 0 %}
                    <span class="standard-price">&euro;{{ product.price|number_format(2, ',', '.') }}</span>
                    <span class="discounted-price">&euro;{{ product.getDiscountedPrice()|number_format(2, ',', '.') }}</span>
                    <span class="discount">{{ product.discountPercentage|number_format(0) }}% off</span>
                {% else %}
                    <span class="discounted-price">&euro;{{ product.price|number_format(2, ',', '.') }}</span>
                {% endif %}
            </p>

            {% if product.tags %}
                <div class="tags">
                    {% for tag in product.tags %}
                        <span class="tag">{{ tag }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </a>
    </div>
{% endfor %}
